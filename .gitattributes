# normalize to LF
.gitattributes text eol=lf
.gitignore text eol=lf

*.c text eol=lf
*.cmake text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.MD text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.yml text eol=lf

# do not touch binary file line endings
*.bin
*.elf
*.hex
*.map
*.a
*.o
